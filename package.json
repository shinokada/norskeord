{
  "name": "norskeord",
  "version": "2.25.6",
  "description": "Norwegian(Bokmål) - English flashcard",
  "homepage": "https://norskeord.no/",
  "repository": {
    "type": "git",
    "url": "https://github.com/shinokada/norskeord"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test",
    "ch": "npx tsx scripts/build-search-index.ts && npx changeset && pnpm stats",
    "cv": "npx changeset version",
    "generate:lessons": "npx tsx --env-file=.env scripts/generate-lessons.ts",
    "og": "node scripts/generate-og.mjs",
    "og:blog": "node scripts/generate-og.mjs --blog",
    "og:decks": "node scripts/generate-og.mjs --decks",
    "stats": "node scripts/generate-stats.mjs",
    "search:index": "npx tsx scripts/build-search-index.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@changesets/cli": "^2.31.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.19.0",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "clsx": "^2.1.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "flowbite": "^4.0.2",
    "flowbite-svelte": "^1.33.1",
    "flowbite-svelte-icons": "^3.1.0",
    "glob": "^13.0.6",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "mdsvex": "^0.12.7",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "runatics": "^0.3.0",
    "runes-meta-tags": "^0.5.0",
    "runes-webkit": "^0.12.1",
    "super-sitemap": "^1.0.12",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "terser": "^5.48.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "resend": "^6.12.4",
    "ts-fsrs": "^5.4.1"
  }
}
