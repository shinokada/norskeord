{
  "name": "norskeord",
  "version": "2.11.0",
  "description": "Norwegian(Bokmål) - English flashcard",
  "homepage": "https://norskeord.no/",
  "repository": {
    "type": "git",
    "url": "https://github.com/shinokada/norskeord"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test",
    "ch": "npx changeset",
    "cv": "npx changeset version",
    "generate:lessons": "npx tsx --env-file=.env scripts/generate-lessons.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.18.0",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-vercel": "^5.10.3",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@svitejs/changesets-changelog-github-compact": "^1.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "clsx": "^2.1.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "flowbite": "^4.0.2",
    "flowbite-svelte": "^1.33.1",
    "flowbite-svelte-icons": "^3.1.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "mdsvex": "^0.12.7",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "runatics": "^0.2.0",
    "runes-meta-tags": "^0.5.0",
    "runes-webkit": "^0.12.1",
    "super-sitemap": "^1.0.12",
    "svelte": "^5.55.8",
    "svelte-check": "^4.4.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "terser": "^5.47.1",
    "tsx": "^4.22.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.13",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.0",
    "resend": "^6.12.3",
    "ts-fsrs": "^5.4.0"
  }
}
