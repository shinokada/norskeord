{
  "name": "norskeord",
  "version": "2.116.2",
  "description": "Norwegian(Bokmål) - English flashcard",
  "homepage": "https://norskeord.no/",
  "repository": {
    "type": "git",
    "url": "https://github.com/shinokada/norskeord"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm stats && pnpm content:index && vite dev",
    "build": "pnpm stats && pnpm grammar:split && pnpm content:index && vite build",
    "grammar:split": "node scripts/build-grammar-level-index.mjs",
    "content:index": "node scripts/build-content-index.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:i18n": "node scripts/check-message-keys.mjs && node scripts/check-unused-keys.mjs && npx tsx scripts/check-category-keys.ts",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest --run",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:e2e": "playwright test",
    "ch": "npx changeset && pnpm stats",
    "cv": "npx changeset version",
    "generate:lessons": "npx tsx --env-file=.env scripts/generate-lessons.ts",
    "cleanup:e2e-users": "npx tsx --env-file=.env scripts/cleanup-e2e-users.ts",
    "og": "node scripts/generate-og.mjs",
    "og:blog": "node scripts/generate-og.mjs --blog",
    "og:decks": "node scripts/generate-og.mjs --decks",
    "stats": "node scripts/generate-stats.mjs",
    "check:languages": "node scripts/check-language-sync.mjs",
    "check:unused-keys": "node scripts/check-unused-keys.mjs",
    "check:category-keys": "npx tsx scripts/check-category-keys.ts",
    "check:spelling": "npx tsx scripts/check-spelling.ts",
    "check:ids": "npx tsx scripts/check-ids.ts --strict",
    "check:slugs": "npx tsx scripts/check-slugs.ts --strict",
    "check:data": "npx tsx scripts/check-vocab.ts --strict && npx tsx scripts/check-uttrykk.ts --strict && npx tsx scripts/check-ids.ts --strict && npx tsx scripts/check-slugs.ts --strict"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.29.3",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.19.2",
    "clsx": "^2.1.1",
    "dictionary-de": "^3.0.0",
    "dictionary-es": "^4.0.0",
    "dictionary-nb": "^3.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "flowbite": "^4.0.2",
    "flowbite-svelte": "^1.33.1",
    "flowbite-svelte-icons": "^3.1.0",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "mdsvex": "^0.12.8",
    "nspell": "^2.1.5",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "runatics": "^0.3.1",
    "runes-meta-tags": "^0.5.2",
    "runes-webkit": "^0.12.2",
    "super-sitemap": "^2.0.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-devtools-json": "^1.1.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "resend": "^6.35.0",
    "ts-fsrs": "^5.4.2"
  }
}
