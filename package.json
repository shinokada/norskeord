{
  "name": "norskeord",
  "version": "2.58.0",
  "description": "Norwegian(Bokmål) - English flashcard",
  "homepage": "https://norskeord.no/",
  "repository": {
    "type": "git",
    "url": "https://github.com/shinokada/norskeord"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm stats && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:i18n": "node scripts/check-message-keys.mjs && node scripts/check-unused-keys.mjs && npx tsx scripts/check-category-keys.ts",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest --run",
    "test": "npm run test:e2e && npm run test:unit",
    "test:e2e": "playwright test",
    "ch": "npx tsx scripts/build-search-index.ts && npx changeset && pnpm stats",
    "cv": "npx changeset version",
    "generate:lessons": "npx tsx --env-file=.env scripts/generate-lessons.ts",
    "cleanup:e2e-users": "npx tsx --env-file=.env scripts/cleanup-e2e-users.ts",
    "og": "node scripts/generate-og.mjs",
    "og:blog": "node scripts/generate-og.mjs --blog",
    "og:decks": "node scripts/generate-og.mjs --decks",
    "stats": "node scripts/generate-stats.mjs",
    "search:index": "npx tsx scripts/build-search-index.ts",
    "check:languages": "node scripts/check-language-sync.mjs",
    "check:unused-keys": "node scripts/check-unused-keys.mjs",
    "check:category-keys": "npx tsx scripts/check-category-keys.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.112.4",
    "@changesets/cli": "^2.31.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.22.0",
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "clsx": "^2.1.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.21.0",
    "flowbite": "^4.0.2",
    "flowbite-svelte": "^1.33.1",
    "flowbite-svelte-icons": "^3.1.0",
    "glob": "^13.0.6",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "mdsvex": "^0.12.8",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "runatics": "^0.3.0",
    "runes-meta-tags": "^0.5.0",
    "runes-webkit": "^0.12.1",
    "super-sitemap": "^1.0.12",
    "svelte": "^5.56.7",
    "svelte-check": "^4.7.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "terser": "^5.49.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "resend": "^6.17.2",
    "ts-fsrs": "^5.4.1"
  }
}
